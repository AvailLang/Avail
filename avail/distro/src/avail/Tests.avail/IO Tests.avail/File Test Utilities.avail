Module "File Test Utilities"
Versions
	"Avail-1.6.1"
Uses
	"Avail",
	"Common"
Names
	/* File names. */
	"test directory",
	"abracadabra.txt",
	"scratch.txt",
	"a fresh test file name",
	"a private copy of abracadabra.txt",

	/* Potentially unsupported operations. */
	"Try_",

	/* Utilities. */
	"Randomly permute file access rights for__times"
Body

Private method "a test directory" is
[
	temporary directory/“a UUID” (UUID)
];

/* The test directory. */
testDir : file name;

/**
 * Create a new file with the specified name, containing the UTF-8 encoding of
 * "abracadabra".
 *
 * @method "Create an abracadabra file named_"
 * @param "fn" "file name"
 *        The name of the file to create.  No file may exist by that name.
 * @returns "⊤"
 */
Private method "Create an abracadabra file named_" is
[
	fn : file name
|
	Using a file writer for fn with options {create new}, do
	[
		f : file writer
	|
		bytes ::= take at most ∞ from
			a reader over "abracadabra"
				converted by a UTF8 encoder;
		Write bytes to f;
	];
] : ⊤;

/* The files created here are shared by every I/O test, and the I/O tests run
 * concurrently, so no test may modify them.  A test that changes a file's
 * access rights, contents, or name works on a file of its own, from {@method
 * "a private copy of abracadabra.txt"} or {@method "a fresh test file name"}.
 */
Before running I/O test suite, do
[
	testDir := a test directory;
	Create a directory named testDir;
	Create an abracadabra file named testDir/"abracadabra.txt";
	Close a file writer for testDir/"scratch.txt"
		with options {create new};
];

After running I/O test suite, do
[
	Recursively unlink testDir if necessary;
	Clear testDir;
];

Method "test directory" is [testDir];

Public method "abracadabra.txt" is
[
	test directory/"abracadabra.txt"
];

Public method "scratch.txt" is
[
	test directory/"scratch.txt"
];

/**
 * Answer a name for a file in the {@method "test directory"} that no other
 * test uses.  No file exists by that name.
 *
 * @method "a fresh test file name"
 * @returns "file name"
 */
Public method "a fresh test file name" is
[
	name ::= “a UUID” (UUID) ++ ".txt";
	test directory/name
] : file name;

/**
 * Create a file in the {@method "test directory"} that no other test uses,
 * with the same contents as {@method "abracadabra.txt"}, and answer its name.
 * A test that changes a file's access rights uses such a copy, since the
 * shared file is read by other tests concurrently.
 *
 * @method "a private copy of abracadabra.txt"
 * @returns "file name"
 */
Public method "a private copy of abracadabra.txt" is
[
	fn ::= a fresh test file name;
	Create an abracadabra file named fn;
	fn
] : file name;

Public method "Try_" is
[
	aFunction : []→⊤
|
	Guard aFunction
	intercept [e : unsupported-operation exception | /* Ignore. */];
] : ⊤;

Public method "Randomly permute file access rights for__times" is
[
	f : [{file access right|0..9}]→⊤,
	count : whole number
|
	allRights ::= file access right's instances→tuple ?→ <file access right…|9>;
	rng ::= a pRNG;
	Repeat
	[
		n ::= rng's next [0..12];
		rights : {file access right|} := ∅;
		Repeat [rights := rights + rng's next element of allRights;] n times;
		/* Java attempts to *open* files with read only access in order to
		 * extract their permission bits.  Obviously that won't work if the
		 * owner read permission is absent (at least if group/other read are also
		 * absent).  Just add owner read to keep things happy.
		 */
		rights := rights + owner read;
		f(rights);
	] count times;
];
